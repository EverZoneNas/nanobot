#!/usr/bin/env bash
# Local launcher for nanobot gateway + WebUI.
# Copy to start-nanobot.sh and fill in secrets (start-nanobot.sh is gitignored).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="${ROOT}/config.json"
WEBUI="${ROOT}/webui"
NANOBOT="${ROOT}/.venv/bin/nanobot"
PYTHON="${ROOT}/.venv/bin/python"

# --- secrets: edit locally ---
export OPENROUTER_API_KEY="REPLACE_WITH_YOUR_OPENROUTER_API_KEY"
export NANOBOT_WS_TOKEN_SECRET="REPLACE_WITH_YOUR_WS_TOKEN_SECRET"

if [[ ! -x "$NANOBOT" ]]; then
  echo "error: nanobot not found at $NANOBOT" >&2
  echo "Create the venv or adjust NANOBOT in this script." >&2
  exit 1
fi

if [[ ! -f "$CONFIG" ]]; then
  echo "error: config not found at $CONFIG" >&2
  exit 1
fi

if [[ "$OPENROUTER_API_KEY" == REPLACE_WITH_YOUR_* ]]; then
  echo "error: set OPENROUTER_API_KEY in $0" >&2
  exit 1
fi

if [[ "$NANOBOT_WS_TOKEN_SECRET" == REPLACE_WITH_YOUR_* ]]; then
  echo "error: set NANOBOT_WS_TOKEN_SECRET in $0" >&2
  exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "error: bun not found (required to build webui)" >&2
  exit 1
fi

if [[ ! -d "$WEBUI" ]]; then
  echo "error: webui directory not found at $WEBUI" >&2
  exit 1
fi

gateway_cmd() {
  "$NANOBOT" gateway "$@" -c "$CONFIG"
}

gateway_running() {
  [[ "$(gateway_cmd status 2>/dev/null | awk '/^Running:/{print $2; exit}')" == "yes" ]]
}

RESTART=false
for arg in "$@"; do
  case "$arg" in
    --restart) RESTART=true ;;
    -h|--help)
      echo "Usage: $0 [--restart]"
      echo "  --restart  stop and restart the gateway if it is already running"
      exit 0
      ;;
    *)
      echo "error: unknown argument: $arg" >&2
      echo "Usage: $0 [--restart]" >&2
      exit 1
      ;;
  esac
done

echo "==> building webui"
(cd "$WEBUI" && bun run build)

echo ""
echo "==> nanobot gateway"
if gateway_running; then
  if [[ "$RESTART" == true ]]; then
    echo "    restarting (already running, --restart set)..."
    gateway_cmd restart
  else
    echo "    already running (use --restart to kill and restart)"
  fi
else
  echo "    starting in background..."
  gateway_cmd --background
fi

echo ""
gateway_cmd status

read -r ws_host ws_port <<EOF
$("$PYTHON" -c "
import json
from pathlib import Path
cfg = json.loads(Path('${CONFIG}').read_text(encoding='utf-8'))
ws = cfg.get('channels', {}).get('websocket', {})
host = ws.get('host') or '127.0.0.1'
port = ws.get('port') or 8765
browser_host = '127.0.0.1' if host in ('127.0.0.1', '0.0.0.0', '::') else host
print(browser_host, port)
")
EOF

secret_url=$("$PYTHON" -c "
from urllib.parse import quote
import os
print(quote(os.environ['NANOBOT_WS_TOKEN_SECRET'], safe=''))
")

echo ""
echo "WebUI (served by gateway): http://${ws_host}:${ws_port}/#/?bootstrapSecret=${secret_url}"
echo "Manage: ${NANOBOT} gateway {status,logs,stop,restart} -c ${CONFIG}"
